FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system --gid 10001 centinelax \
    && adduser \
       --system \
       --uid 10001 \
       --ingroup centinelax \
       --home /nonexistent \
       centinelax

COPY requirements.txt requirements-dev.txt ./

RUN pip install --upgrade pip \
    && pip install -r requirements-dev.txt

COPY . .

RUN chown -R centinelax:centinelax /app

USER centinelax

EXPOSE 8000

CMD ["gunicorn", "--reload", "--bind", "0.0.0.0:8000", "--workers", "1", "--threads", "4", "--timeout", "60", "--access-logfile", "-", "--error-logfile", "-", "wsgi:app"]
